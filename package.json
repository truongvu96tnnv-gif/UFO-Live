{
  "name": "ufo-live",
  "version": "0.1.0",
  "private": true,
  "description": "Game tương tác TikTok Live: Bảo Vệ Trái Đất — cả live bắn hạ UFO xâm lược",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "lint": "tsc --noEmit",
    "test": "node --import tsx --test server/*.test.mjs src/game/*.test.mjs",
    "bridge": "tsx server/index.ts",
    "start": "npm run build && tsx server/index.ts",
    "build:embed": "tsc --noEmit && vite build --mode embed && node scripts/embed.mjs"
  },
  "dependencies": {
    "@fontsource/chakra-petch": "^5.3.0",
    "three": "^0.170.0",
    "tiktok-live-connector": "^2.5.0",
    "ws": "^8.18.3"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "@types/three": "^0.170.0",
    "@types/ws": "^8.5.13",
    "tsx": "^4.19.2",
    "typescript": "^5.9.3",
    "vite": "^7.1.0"
  },
  "engines": {
    "node": ">=22"
  }
}
